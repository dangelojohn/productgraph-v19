<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company isolation. Each ECO carries company_id and is only
             visible to users whose allowed_company_ids contain it. -->
        <record id="pg_eco_rule_company" model="ir.rule">
            <field name="name">ECO: multi-company</field>
            <field name="model_id" ref="model_pg_eco"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
