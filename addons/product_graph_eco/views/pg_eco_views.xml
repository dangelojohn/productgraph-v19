<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_eco_list" model="ir.ui.view">
        <field name="name">pg.eco.list</field>
        <field name="model">pg.eco</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'draft'"
                  decoration-info="state in ('analysis', 'approval')"
                  decoration-primary="state == 'implementation'"
                  decoration-success="state == 'released'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="title"/>
                <field name="change_type"/>
                <field name="priority" widget="badge"
                       decoration-warning="priority == 'high'"
                       decoration-danger="priority == 'critical'"/>
                <field name="state" widget="badge"/>
                <field name="requestor_id"/>
                <field name="engineering_lead_id"/>
                <field name="line_count" string="# Items"/>
                <field name="target_release_date"
                       decoration-danger="target_release_date and target_release_date &lt; current_date and state not in ('released', 'rejected')"
                       decoration-warning="target_release_date and target_release_date &gt;= current_date and state not in ('released', 'rejected')"/>
                <field name="escalation_level" widget="badge"
                       decoration-warning="escalation_level == 1"
                       decoration-danger="escalation_level &gt;= 2"
                       invisible="not escalation_level"
                       optional="show"/>
                <field name="actual_release_date" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pg_eco_kanban" model="ir.ui.view">
        <field name="name">pg.eco.kanban</field>
        <field name="model">pg.eco</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="title"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="change_type"/>
                <field name="line_count"/>
                <field name="requestor_id"/>
                <field name="target_release_date"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="title"/>
                            <div class="text-muted">
                                <i class="fa fa-tag" title="Change Type"/>
                                <field name="change_type"/>
                                · <field name="line_count"/> items
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="requestor_id" widget="many2one_avatar_user"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="target_release_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pg_eco_search" model="ir.ui.view">
        <field name="name">pg.eco.search</field>
        <field name="model">pg.eco</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="requestor_id"/>
                <field name="engineering_lead_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_open" string="Open (not released/rejected)"
                        domain="[('state', 'not in', ('released', 'rejected'))]"/>
                <filter name="filter_released" string="Released"
                        domain="[('state', '=', 'released')]"/>
                <filter name="filter_high_priority" string="High / Critical Priority"
                        domain="[('priority', 'in', ('high', 'critical'))]"/>
                <filter name="filter_mine" string="My ECOs"
                        domain="[('requestor_id', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_priority" string="Priority"
                            context="{'group_by': 'priority'}"/>
                    <filter name="group_change_type" string="Change Type"
                            context="{'group_by': 'change_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pg_eco_form" model="ir.ui.view">
        <field name="name">pg.eco.form</field>
        <field name="model">pg.eco</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- PG-161: one-click Promote (advance to next valid state)
                         and Express Release (draft → released in one shot,
                         admin-only when SoD is enforced). -->
                    <button name="action_promote" string="Promote"
                            type="object" class="btn-primary"
                            invisible="not can_promote"
                            help="Advance ECO to the next valid state. Reuses normal gating."/>
                    <button name="action_express_release" string="Express Release"
                            type="object" class="btn-danger"
                            invisible="not can_express_release"
                            confirm="Express Release will fast-track this ECO from Draft through to Released in one step. This is admin-only when SoD is enforced. Continue?"
                            help="One-click draft-through-release for admins or when SoD is disabled. All affected revisions must already be available."/>
                    <button name="action_start_analysis" string="Start Analysis"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="product_graph_base.group_pg_engineer"/>
                    <button name="action_submit_for_approval" string="Submit for Approval"
                            type="object" class="oe_highlight"
                            invisible="state != 'analysis'"
                            groups="product_graph_base.group_pg_engineer"/>
                    <button name="action_reset_to_draft" string="Back to Draft"
                            type="object"
                            invisible="state != 'analysis'"
                            groups="product_graph_base.group_pg_engineer"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'approval'"
                            groups="product_graph_base.group_pg_approver"/>
                    <!-- PG-XXX — Reject opens a wizard that collects the
                         required rejection reason before calling
                         action_reject(). The prior button used only a
                         yes/no confirm dialog with no reason input, so
                         clicking it always raised ValidationError. -->
                    <button name="%(product_graph_eco.action_pg_eco_reject_wizard)d"
                            string="Reject"
                            type="action" class="btn-danger"
                            invisible="state != 'approval'"
                            groups="product_graph_base.group_pg_approver"
                            context="{'default_eco_id': id}"/>
                    <button name="action_release" string="Release"
                            type="object" class="oe_highlight"
                            invisible="state != 'implementation'"
                            groups="product_graph_base.group_pg_approver"
                            confirm="Release this ECO? Released ECOs are immutable."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,analysis,approval,implementation,released"/>
                </header>
                <sheet>
                    <!-- PG-161: lifecycle-button compute flags. -->
                    <field name="can_promote" invisible="1"/>
                    <field name="promote_blocked_reason" invisible="1"/>
                    <field name="can_express_release" invisible="1"/>
                    <field name="express_release_blocked_reason" invisible="1"/>
                    <!-- PG-161: surface the "why can't I promote?" reason as
                         an info banner whenever the ECO is in a non-final
                         state and Promote is unavailable. -->
                    <div class="alert alert-info" role="alert"
                         invisible="can_promote or state in ('released', 'rejected') or not promote_blocked_reason">
                        <i class="fa fa-info-circle"/>
                        <field name="promote_blocked_reason" nolabel="1" readonly="1"/>
                    </div>
                    <!-- PG-134: surface escalation level as a banner. -->
                    <div class="alert alert-danger" role="alert"
                         invisible="escalation_level &lt; 2">
                        <i class="fa fa-exclamation-triangle"/>
                        This ECO is critically overdue.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="escalation_level != 1">
                        <i class="fa fa-exclamation-circle"/>
                        This ECO is past its Target Release Date (escalation
                        level 1).
                    </div>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1>
                            <field name="title" placeholder="Short description of the change..."/>
                        </h1>
                        <h3 class="text-muted">
                            <field name="name" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="change_type"/>
                            <field name="priority"/>
                            <field name="requestor_id"/>
                            <field name="engineering_lead_id"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="target_release_date"/>
                            <field name="actual_release_date"/>
                            <field name="escalation_level" readonly="1"
                                   invisible="not escalation_level"/>
                            <field name="escalation_stamped_at" readonly="1"
                                   invisible="not escalation_level"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Affected Items" name="lines">
                            <field name="line_ids" readonly="state in ('released', 'rejected')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_id"/>
                                    <field name="from_revision_id"/>
                                    <field name="to_revision_id"/>
                                    <field name="change_kind"/>
                                    <field name="status"/>
                                    <field name="notes"/>
                                    <!-- PG-131: spawn a draft target revision from the predecessor. -->
                                    <button name="action_spawn_revision"
                                            string="Spawn Target Revision"
                                            type="object"
                                            icon="fa-plus-square-o"
                                            invisible="to_revision_id or change_kind in ('obsolete', 'introduce')"
                                            help="Create a draft target revision for this line by cloning the predecessor's properties and released EBOM."/>
                                    <!-- PG-132: explode closure to find downstream assemblies. -->
                                    <button name="action_explode_impact"
                                            string="Explode Impact"
                                            type="object"
                                            class="btn-secondary"
                                            icon="fa-sitemap"
                                            invisible="not item_id"
                                            help="Find all assemblies using this item and suggest adding them as affected items."/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval Board" name="board">
                            <group>
                                <field name="approval_board_ids" widget="many2many_tags"
                                       options="{'no_create_edit': True}"/>
                            </group>
                            <field name="approval_ids" readonly="1">
                                <list>
                                    <field name="signed_on"/>
                                    <field name="user_id"/>
                                    <field name="decision" widget="badge"
                                           decoration-success="decision == 'approved'"
                                           decoration-danger="decision == 'rejected'"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Impact Summary" name="impact">
                            <field name="impact_summary"/>
                        </page>
                        <page string="Rejection" name="rejection"
                              invisible="state != 'rejected'">
                            <field name="rejection_reason" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pg_eco" model="ir.actions.act_window">
        <field name="name">Engineering Change Orders</field>
        <field name="res_model">pg.eco</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_pg_eco_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Engineering Change Order</p>
            <p>An ECO bundles a coordinated set of revision changes behind a governed
               approval workflow.</p>
        </field>
    </record>

</odoo>
