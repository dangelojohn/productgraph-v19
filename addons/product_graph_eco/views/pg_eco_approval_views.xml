<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_eco_approval_list" model="ir.ui.view">
        <field name="name">pg.eco.approval.list</field>
        <field name="model">pg.eco.approval</field>
        <field name="arch" type="xml">
            <list>
                <field name="signed_on"/>
                <field name="eco_id"/>
                <field name="user_id"/>
                <field name="decision" widget="badge"
                       decoration-success="decision == 'approved'"
                       decoration-danger="decision == 'rejected'"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="action_pg_eco_approval" model="ir.actions.act_window">
        <field name="name">ECO Approval Log</field>
        <field name="res_model">pg.eco.approval</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
