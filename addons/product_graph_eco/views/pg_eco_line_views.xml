<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_eco_line_list" model="ir.ui.view">
        <field name="name">pg.eco.line.list</field>
        <field name="model">pg.eco.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="eco_id"/>
                <field name="item_id"/>
                <field name="from_revision_id"/>
                <field name="to_revision_id"/>
                <field name="change_kind"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'done'"
                       decoration-muted="status == 'skipped'"/>
                <field name="eco_state" widget="badge" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_pg_eco_line" model="ir.actions.act_window">
        <field name="name">ECO Affected Items</field>
        <field name="res_model">pg.eco.line</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
