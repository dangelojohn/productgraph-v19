<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- W003 / R6.1 — surface pg_item_id + pg_rfq_line_id on the
         purchase.requisition line tree. optional="hide" so the buyer
         sees a clean line by default; one column-picker click reveals
         the back-references. -->
    <record id="view_purchase_requisition_form_pg_backref" model="ir.ui.view">
        <field name="name">purchase.requisition.form.pg_backref</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_id']" position="after">
                <field name="pg_item_id" optional="hide"
                       options="{'no_create_edit': True}"/>
                <field name="pg_rfq_line_id" optional="hide"
                       options="{'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

    <!-- W003 / R6.1 — same back-refs on the purchase.order line tree. -->
    <record id="view_purchase_order_form_pg_backref" model="ir.ui.view">
        <field name="name">purchase.order.form.pg_backref</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="pg_item_id" optional="hide"
                       options="{'no_create_edit': True}"/>
                <field name="pg_rfq_line_id" optional="hide"
                       options="{'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

    <!-- W003 — Procurement History smart-button on pg.item. -->
    <record id="view_pg_item_form_procurement" model="ir.ui.view">
        <field name="name">pg.item.form.procurement</field>
        <field name="model">pg.item</field>
        <field name="inherit_id" ref="product_graph_base.view_pg_item_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_lines" type="object"
                        class="oe_stat_button" icon="fa-shopping-cart">
                    <field name="purchase_line_count" widget="statinfo"
                           string="Procurement"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
