<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_rfq_form_procurement" model="ir.ui.view">
        <field name="name">pg.rfq.form.procurement</field>
        <field name="model">pg.rfq</field>
        <field name="inherit_id" ref="product_graph_rfq.view_pg_rfq_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='promote_to_preferred']" position="after">
                <field name="auto_create_requisition"/>
                <field name="requisition_id" readonly="1"
                       options="{'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//button[@name='action_award']" position="after">
                <button name="action_view_requisition"
                        string="Open Requisition"
                        type="object" class="btn-secondary"
                        invisible="not requisition_id"/>
            </xpath>
        </field>
    </record>

</odoo>
