<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: LGPL-3.0-only
     W076 (R6.12, 2026-06-27) — RFQ invitation email.

     Sent to the vendor's res.partner when an RFQ moves to 'sent' (one
     email per distinct vendor across all the RFQ's lines). The body
     deep-links to the FIRST bid for that vendor; the recipient lands
     on /my/rfq-bids if multiple lines.

     This template is intentionally minimal — the production rollout
     would brand it with company logo + footer + multi-line table.
     STUB scope: enough to prove the URL contract end-to-end.
-->
<odoo noupdate="1">
    <record id="mail_template_rfq_invitation" model="mail.template">
        <field name="name">ProductGraph: RFQ Invitation to Vendor</field>
        <field name="model_id" ref="model_pg_rfq_bid"/>
        <field name="subject">Request for Quote: {{ object.rfq_id.display_name }}</field>
        <field name="email_from">{{ (object.rfq_id.requestor_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.vendor_id.partner_id.email or '' }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#333;">
                <p>Hello <t t-out="object.vendor_id.partner_id.name or object.vendor_id.name"/>,</p>

                <p>
                    Southbrook has issued <strong>Request for Quote
                    <t t-out="object.rfq_id.name"/></strong>
                    <t t-if="object.rfq_id.title"> — <t t-out="object.rfq_id.title"/></t>
                    and you are invited to bid.
                </p>

                <p>
                    <strong>Item:</strong>
                    <t t-out="object.line_id.item_id.part_number or object.line_id.item_id.display_name"/><br/>
                    <strong>Quantity:</strong>
                    <t t-out="object.line_id.qty"/><br/>
                    <t t-if="object.line_id.target_date">
                        <strong>Needed by:</strong>
                        <t t-out="object.line_id.target_date"/><br/>
                    </t>
                    <t t-if="object.rfq_id.due_date">
                        <strong>Bid deadline:</strong>
                        <t t-out="object.rfq_id.due_date"/><br/>
                    </t>
                </p>

                <p>
                    Please submit your price, lead time, and minimum order quantity using
                    the portal link below. We do not accept email replies for this RFQ —
                    bids must be entered through the portal so they are routed correctly.
                </p>

                <p style="margin:20px 0;">
                    <a t-att-href="object.get_portal_url()"
                       style="background:#0d6efd;color:#fff;padding:10px 18px;text-decoration:none;border-radius:4px;display:inline-block;">
                        Open RFQ Bid Portal
                    </a>
                </p>

                <p style="font-size:12px;color:#666;">
                    If the button does not work, copy this URL into your browser:<br/>
                    <t t-out="object.get_portal_url()"/>
                </p>

                <p>
                    Thank you,<br/>
                    <t t-out="object.rfq_id.requestor_id.name or (user.name or 'Southbrook Sourcing')"/>
                </p>
            </div>
        </field>
    </record>
</odoo>
