<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record id="ir_cron_auto_draft_missing_rfqs" model="ir.cron">
        <field name="name">ProductGraph: Auto-draft RFQs for unsourced purchased items</field>
        <field name="model_id" ref="model_pg_rfq"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_draft_missing_rfqs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- W032 (R6.7, 2026-06-27) — daily bid-expiry sweep.
         Walks pg.rfq.bid where valid_until < today and flips is_expired
         so the recommended-bid compute drops them. Idempotent. -->
    <record id="ir_cron_flag_expired_bids" model="ir.cron">
        <field name="name">ProductGraph: Flag expired RFQ bids</field>
        <field name="model_id" ref="model_pg_rfq_bid"/>
        <field name="state">code</field>
        <field name="code">model._cron_flag_expired_bids()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
