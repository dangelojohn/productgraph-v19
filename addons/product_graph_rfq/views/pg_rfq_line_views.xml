<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_rfq_line_list" model="ir.ui.view">
        <field name="name">pg.rfq.line.list</field>
        <field name="model">pg.rfq.line</field>
        <field name="arch" type="xml">
            <!-- W058 (R6.11) — decoration-info on the row when the
                 auto-ranker has a recommendation. Lets a buyer spot
                 ready-to-award lines at a glance during triage.
                 W059 (R6.9) — decoration-danger when the recommended
                 bid's MOQ exceeds qty AND the buyer hasn't already
                 accepted the shortfall. Warn, not block. -->
            <list decoration-info="has_recommendation == True"
                  decoration-danger="moq_shortfall == True and moq_shortfall_accepted == False">
                <field name="rfq_id"/>
                <field name="item_id"/>
                <field name="qty"/>
                <field name="target_date"/>
                <field name="bid_count"/>
                <field name="best_unit_price"/>
                <!-- W046 (R6.11) — Recommended bid surfaced inline.
                     widget="badge" + the sibling has_recommendation
                     boolean (column_invisible) give the row decoration
                     a clean signal without re-computing here. -->
                <field name="recommended_bid_id" optional="show"
                       widget="badge"
                       decoration-info="has_recommendation == True"/>
                <field name="has_recommendation" column_invisible="True"/>
                <!-- W059 (R6.9) — MOQ shortfall fields, optional but
                     visible by default so buyers triaging the list
                     see the flag without opening every form. -->
                <field name="moq_shortfall" widget="boolean_toggle"
                       optional="show" readonly="1"/>
                <field name="moq_shortfall_amount" optional="hide"
                       readonly="1"/>
                <field name="moq_shortfall_accepted" widget="boolean_toggle"
                       optional="hide"/>
                <field name="awarded_bid_id"/>
                <field name="rfq_state" widget="badge" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_pg_rfq_line" model="ir.actions.act_window">
        <field name="name">RFQ Lines</field>
        <field name="res_model">pg.rfq.line</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
