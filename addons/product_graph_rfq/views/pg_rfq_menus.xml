<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- PG-142: Consolidated under Sourcing (renamed from Vendors) instead
         of a separate top-level "RFQ" menu. Reduces top-level menu count
         so CAD + Configuration stay visible at standard working widths. -->

    <menuitem id="menu_pg_rfq"
              name="RFQs"
              parent="product_graph_vendor.menu_pg_vendor_root"
              action="action_pg_rfq"
              sequence="40"/>

    <menuitem id="menu_pg_rfq_line"
              name="RFQ Lines"
              parent="product_graph_vendor.menu_pg_vendor_root"
              action="action_pg_rfq_line"
              sequence="50"/>

    <menuitem id="menu_pg_rfq_bid"
              name="Bids"
              parent="product_graph_vendor.menu_pg_vendor_root"
              action="action_pg_rfq_bid"
              sequence="60"/>

</odoo>
