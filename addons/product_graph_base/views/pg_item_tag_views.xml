<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_item_tag_list" model="ir.ui.view">
        <field name="name">pg.item.tag.list</field>
        <field name="model">pg.item.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_pg_item_tag" model="ir.actions.act_window">
        <field name="name">Item Tags</field>
        <field name="res_model">pg.item.tag</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
