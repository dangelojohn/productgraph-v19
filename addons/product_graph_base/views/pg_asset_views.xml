<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_asset_list" model="ir.ui.view">
        <field name="name">pg.asset.list</field>
        <field name="model">pg.asset</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'"
                  decoration-warning="state == 'maintenance'"
                  decoration-muted="state == 'retired'">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="item_id"/>
                <field name="revision_id"/>
                <field name="location"/>
                <field name="state" widget="badge"/>
                <field name="install_date"/>
            </list>
        </field>
    </record>

    <record id="view_pg_asset_form" model="ir.ui.view">
        <field name="name">pg.asset.form</field>
        <field name="model">pg.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_retire" string="Retire" type="object"
                            invisible="state == 'retired'"
                            confirm="Retire this asset?"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,maintenance,retired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="serial_number"/>
                            <field name="item_id"/>
                            <field name="revision_id"/>
                        </group>
                        <group>
                            <field name="location"/>
                            <field name="install_date"/>
                            <field name="retire_date" invisible="state != 'retired'"/>
                        </group>
                    </group>
                    <group string="Phase 4 — IoT Telemetry (reserved)" groups="base.group_no_one">
                        <field name="iot_device_id"/>
                        <field name="last_telemetry"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pg_asset" model="ir.actions.act_window">
        <field name="name">Installed Assets</field>
        <field name="res_model">pg.asset</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
