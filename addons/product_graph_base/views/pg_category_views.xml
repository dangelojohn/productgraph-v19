<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="view_pg_category_list" model="ir.ui.view">
        <field name="name">pg.category.list</field>
        <field name="model">pg.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name" string="Category"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_pg_category_form" model="ir.ui.view">
        <field name="name">pg.category.form</field>
        <field name="model">pg.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Category name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="code"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="item_count" string="# Items"/>
                            <field name="complete_name" string="Full Path"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_pg_category_search" model="ir.ui.view">
        <field name="name">pg.category.search</field>
        <field name="model">pg.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pg_category" model="ir.actions.act_window">
        <field name="name">Engineering Categories</field>
        <field name="res_model">pg.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define engineering categories.
            </p>
        </field>
    </record>

</odoo>
