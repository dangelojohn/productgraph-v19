<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_relationship_list" model="ir.ui.view">
        <field name="name">pg.relationship.list</field>
        <field name="model">pg.relationship</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="source_item_id"/>
                <field name="kind" widget="badge"/>
                <field name="target_item_id"/>
                <field name="is_symmetric" widget="boolean_toggle"/>
                <field name="eco_id" optional="show"/>
                <field name="notes" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pg_relationship_search" model="ir.ui.view">
        <field name="name">pg.relationship.search</field>
        <field name="model">pg.relationship</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_item_id"/>
                <field name="target_item_id"/>
                <field name="kind"/>
                <field name="eco_id"/>
                <filter name="filter_substitutes" string="Substitutes"
                        domain="[('kind', '=', 'substitutes')]"/>
                <filter name="filter_alternates" string="Alternates"
                        domain="[('kind', '=', 'alternates')]"/>
                <filter name="filter_supersedes" string="Supersession Chain"
                        domain="[('kind', '=', 'supersedes')]"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <group>
                    <filter name="group_kind" string="Kind"
                            context="{'group_by': 'kind'}"/>
                    <filter name="group_source" string="Source"
                            context="{'group_by': 'source_item_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pg_relationship_form" model="ir.ui.view">
        <field name="name">pg.relationship.form</field>
        <field name="model">pg.relationship</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="source_item_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="kind"/>
                            <field name="target_item_id"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="is_symmetric" readonly="1"/>
                            <field name="eco_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pg_relationship" model="ir.actions.act_window">
        <field name="name">Relationships</field>
        <field name="res_model">pg.relationship</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pg_relationship_search"/>
    </record>

</odoo>
