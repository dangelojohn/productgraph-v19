<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_cad_import_list" model="ir.ui.view">
        <field name="name">pg.cad.import.list</field>
        <field name="model">pg.cad.import</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed'"
                  decoration-danger="state == 'failed'"
                  decoration-info="state == 'running'">
                <field name="create_date"/>
                <field name="connector_id"/>
                <field name="state" widget="badge"/>
                <field name="started_at"/>
                <field name="completed_at"/>
                <field name="line_count"/>
                <field name="created_count"/>
                <field name="updated_count"/>
            </list>
        </field>
    </record>

    <record id="view_pg_cad_import_form" model="ir.ui.view">
        <field name="name">pg.cad.import.form</field>
        <field name="model">pg.cad.import</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Failed"
                            bg_color="text-bg-danger"
                            invisible="state != 'failed'"/>
                    <widget name="web_ribbon" title="Running"
                            bg_color="text-bg-info"
                            invisible="state != 'running'"/>
                    <group>
                        <group>
                            <field name="connector_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="line_count" readonly="1"/>
                            <field name="created_count" readonly="1"/>
                            <field name="updated_count" readonly="1"/>
                            <field name="skipped_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trace" name="trace">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="part_number"/>
                                    <field name="action" widget="badge"
                                           decoration-success="action == 'created'"
                                           decoration-info="action == 'updated'"
                                           decoration-muted="action == 'skipped'"
                                           decoration-danger="action == 'error'"/>
                                    <field name="item_id"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Failure Reason" name="failure"
                              invisible="state != 'failed'">
                            <field name="failure_reason" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pg_cad_import" model="ir.actions.act_window">
        <field name="name">CAD Imports</field>
        <field name="res_model">pg.cad.import</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
