<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_cad_connector_list" model="ir.ui.view">
        <field name="name">pg.cad.connector.list</field>
        <field name="model">pg.cad.connector</field>
        <field name="arch" type="xml">
            <list decoration-success="last_sync_status == 'ok'"
                  decoration-warning="last_sync_status == 'partial'"
                  decoration-danger="last_sync_status == 'failed'"
                  decoration-muted="state == 'inactive'">
                <field name="code"/>
                <field name="name"/>
                <field name="driver_code"/>
                <field name="state" widget="badge"/>
                <field name="sync_schedule"/>
                <field name="last_sync_at"/>
                <field name="next_sync_at" optional="show"/>
                <field name="last_sync_status" widget="badge"/>
                <field name="import_count" string="# Pulls"/>
            </list>
        </field>
    </record>

    <record id="view_pg_cad_connector_form" model="ir.ui.view">
        <field name="name">pg.cad.connector.form</field>
        <field name="model">pg.cad.connector</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" string="Test Connection"
                            type="object" class="btn-secondary"
                            groups="product_graph_base.group_pg_engineer"/>
                    <button name="action_pull" string="Pull Now"
                            type="object" class="oe_highlight"
                            invisible="state != 'active'"
                            groups="product_graph_base.group_pg_engineer"
                            confirm="Pull every document from this connector and create / update items + revisions + EBOMs?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_imports" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="import_count" widget="statinfo"
                                   string="Sync History"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Connector name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="driver_code"/>
                            <field name="create_revision"/>
                            <field name="create_ebom"/>
                            <field name="auto_revise_on_change"/>
                            <field name="responsible_user_id"/>
                        </group>
                        <group>
                            <field name="sync_schedule"/>
                            <field name="next_sync_at" readonly="1"
                                   invisible="sync_schedule == 'manual'"/>
                            <field name="last_sync_at" readonly="1"/>
                            <field name="last_sync_status" readonly="1"/>
                            <field name="import_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Driver Config" name="config">
                            <field name="config_json" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Last Sync Detail" name="last_sync"
                              invisible="not last_sync_detail">
                            <field name="last_sync_detail" readonly="1"/>
                        </page>
                        <page string="Imports" name="imports">
                            <field name="import_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'completed'"
                                           decoration-danger="state == 'failed'"
                                           decoration-info="state == 'running'"/>
                                    <field name="started_at"/>
                                    <field name="completed_at"/>
                                    <field name="line_count"/>
                                    <field name="created_count"/>
                                    <field name="updated_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pg_cad_connector" model="ir.actions.act_window">
        <field name="name">CAD Connectors</field>
        <field name="res_model">pg.cad.connector</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No CAD connectors configured.
            </p>
            <p>
                Click <b>New</b> to set up a SOLIDWORKS, Onshape, or JSON
                file connector. The JSON file driver is the recommended
                starting point — every CAD / PDM system can export its
                BOM to JSON, and the same payload shape works for all
                drivers.
            </p>
        </field>
    </record>

</odoo>
