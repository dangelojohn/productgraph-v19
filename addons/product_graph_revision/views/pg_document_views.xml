<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_document_list" model="ir.ui.view">
        <field name="name">pg.document.list</field>
        <field name="model">pg.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="item_id"/>
                <field name="revision_id"/>
                <field name="name"/>
                <field name="document_type"/>
                <field name="version_label"/>
                <field name="file_data" widget="binary" filename="file_name"/>
                <field name="uploaded_by_id"/>
                <field name="uploaded_at"/>
            </list>
        </field>
    </record>

    <record id="view_pg_document_form" model="ir.ui.view">
        <field name="name">pg.document.form</field>
        <field name="model">pg.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="revision_id"/>
                            <field name="document_type"/>
                            <field name="version_label"/>
                        </group>
                        <group>
                            <field name="uploaded_by_id" readonly="1"/>
                            <field name="uploaded_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="file_data" widget="binary" filename="file_name"/>
                        <field name="file_name"/>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pg_document" model="ir.actions.act_window">
        <field name="name">Engineering Documents</field>
        <field name="res_model">pg.document</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
