<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default sequence for revision codes when generated programmatically.
             Most revisions get an alphabetic code (A, B, C…) via pg.item._next_revision_code(),
             but documents often want a numeric sequence. -->
        <record id="seq_pg_revision_doc" model="ir.sequence">
            <field name="name">ProductGraph — Document Revision (numeric)</field>
            <field name="code">pg.revision.doc</field>
            <field name="prefix"></field>
            <field name="padding">2</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
