<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Daily sweep of frozen MOs (MG-1 follow-up).

            For every completed pg.release with frozen_mo_ids that still have
            open state (draft/confirmed/progress), create a mail.activity for
            the Manufacturing group asking a human to decide whether to
            migrate the MO to the new BOM or let it complete on the old one.

            Idempotent: skips MOs that already have an open pg-frozen-mo
            activity outstanding.
        -->
        <record id="ir_cron_pg_release_frozen_mo_followup" model="ir.cron">
            <field name="name">ProductGraph: Frozen-MO Follow-up</field>
            <field name="model_id" ref="model_pg_release"/>
            <field name="state">code</field>
            <field name="code">model._cron_followup_frozen_mos()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
