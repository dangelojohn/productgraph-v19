<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- PG-142: Renamed root from "Vendors" to "Sourcing" so RFQ menus can
         consolidate underneath, reducing top-level menu count and keeping
         CAD + Configuration out of the responsive overflow. -->
    <menuitem id="menu_pg_vendor_root"
              name="Sourcing"
              parent="product_graph_base.menu_pg_root"
              sequence="40"/>

    <menuitem id="menu_pg_vendor"
              name="Vendors"
              parent="menu_pg_vendor_root"
              action="action_pg_vendor"
              sequence="10"/>

    <menuitem id="menu_pg_vendor_part"
              name="Vendor Parts (AVL)"
              parent="menu_pg_vendor_root"
              action="action_pg_vendor_part"
              sequence="20"/>

    <menuitem id="menu_pg_vendor_qualification"
              name="Qualification Log"
              parent="menu_pg_vendor_root"
              action="action_pg_vendor_qualification"
              sequence="30"/>

</odoo>
