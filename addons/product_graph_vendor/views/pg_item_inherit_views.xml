<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_item_form_inherit_vendor" model="ir.ui.view">
        <field name="name">pg.item.form.inherit.vendor</field>
        <field name="model">pg.item</field>
        <field name="inherit_id" ref="product_graph_base.view_pg_item_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_properties']" position="after">
                <page string="Approved Sources" name="page_avl">
                    <group>
                        <field name="vendor_part_count" readonly="1"/>
                        <field name="primary_vendor_id" readonly="1"
                               options="{'no_create_edit': True}"/>
                    </group>
                    <field name="vendor_part_ids">
                        <list editable="bottom"
                              decoration-muted="not is_qualified"
                              decoration-bf="is_preferred">
                            <field name="vendor_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="vendor_part_number"/>
                            <field name="rank"/>
                            <field name="is_preferred" widget="boolean_toggle"/>
                            <field name="vendor_state" widget="badge"
                                   decoration-success="vendor_state == 'qualified'"
                                   decoration-warning="vendor_state == 'suspended'"
                                   decoration-danger="vendor_state == 'disqualified'"/>
                            <field name="moq"/>
                            <field name="unit_price_hint"/>
                            <field name="currency_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="lead_time_days"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
