<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_vendor_part_list" model="ir.ui.view">
        <field name="name">pg.vendor.part.list</field>
        <field name="model">pg.vendor.part</field>
        <field name="arch" type="xml">
            <list decoration-muted="not is_qualified"
                  decoration-bf="is_preferred">
                <field name="item_id"/>
                <field name="vendor_id"/>
                <field name="vendor_part_number"/>
                <field name="rank"/>
                <field name="is_preferred" widget="boolean_toggle"/>
                <field name="vendor_state" widget="badge"
                       decoration-success="vendor_state == 'qualified'"
                       decoration-warning="vendor_state == 'suspended'"
                       decoration-danger="vendor_state == 'disqualified'"/>
                <field name="moq"/>
                <field name="unit_price_hint"/>
                <field name="currency_id" optional="hide"/>
                <field name="lead_time_days"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pg_vendor_part_search" model="ir.ui.view">
        <field name="name">pg.vendor.part.search</field>
        <field name="model">pg.vendor.part</field>
        <field name="arch" type="xml">
            <search>
                <field name="item_id"/>
                <field name="vendor_id"/>
                <field name="vendor_part_number"/>
                <filter name="filter_preferred" string="Preferred Sources"
                        domain="[('is_preferred', '=', True)]"/>
                <filter name="filter_qualified" string="From Qualified Vendor"
                        domain="[('is_qualified', '=', True)]"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <group>
                    <filter name="group_item" string="Item"
                            context="{'group_by': 'item_id'}"/>
                    <filter name="group_vendor" string="Vendor"
                            context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_state" string="Vendor State"
                            context="{'group_by': 'vendor_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pg_vendor_part_form" model="ir.ui.view">
        <field name="name">pg.vendor.part.form</field>
        <field name="model">pg.vendor.part</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="item_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="vendor_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="vendor_part_number"/>
                            <field name="rank"/>
                            <field name="is_preferred"/>
                            <field name="is_qualified" readonly="1"/>
                            <field name="vendor_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="moq"/>
                            <field name="unit_price_hint"/>
                            <field name="currency_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="lead_time_days"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pg_vendor_part" model="ir.actions.act_window">
        <field name="name">Vendor Parts (AVL)</field>
        <field name="res_model">pg.vendor.part</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pg_vendor_part_search"/>
    </record>

</odoo>
