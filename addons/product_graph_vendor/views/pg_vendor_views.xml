<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_vendor_list" model="ir.ui.view">
        <field name="name">pg.vendor.list</field>
        <field name="model">pg.vendor</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'unqualified'"
                  decoration-info="state == 'probationary'"
                  decoration-success="state == 'qualified'"
                  decoration-warning="state == 'suspended'"
                  decoration-danger="state == 'disqualified'">
                <field name="code"/>
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="qualified_on"/>
                <field name="qualified_by_id"/>
                <field name="vendor_part_count" string="# Parts"/>
                <field name="item_count" string="# Items"/>
                <field name="qualification_expires_on" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pg_vendor_kanban" model="ir.ui.view">
        <field name="name">pg.vendor.kanban</field>
        <field name="model">pg.vendor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="code"/>
                <field name="state"/>
                <field name="vendor_part_count"/>
                <field name="item_count"/>
                <field name="qualified_on"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                        </div>
                        <div class="o_kanban_record_body">
                            <div class="text-muted">
                                <field name="code"/>
                            </div>
                            <div>
                                <field name="vendor_part_count"/> parts ·
                                <field name="item_count"/> items
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_right">
                                <field name="qualified_on"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pg_vendor_search" model="ir.ui.view">
        <field name="name">pg.vendor.search</field>
        <field name="model">pg.vendor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <filter name="filter_qualified" string="Qualified"
                        domain="[('state', '=', 'qualified')]"/>
                <filter name="filter_probationary" string="Probationary"
                        domain="[('state', '=', 'probationary')]"/>
                <filter name="filter_suspended" string="Suspended"
                        domain="[('state', '=', 'suspended')]"/>
                <filter name="filter_open" string="Not Disqualified"
                        domain="[('state', '!=', 'disqualified')]"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <group>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pg_vendor_form" model="ir.ui.view">
        <field name="name">pg.vendor.form</field>
        <field name="model">pg.vendor</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_to_probationary" string="Move to Probationary"
                            type="object" class="oe_highlight"
                            invisible="state != 'unqualified'"
                            groups="product_graph_base.group_pg_approver"/>
                    <button name="action_qualify" string="Qualify"
                            type="object" class="oe_highlight"
                            invisible="state not in ('probationary', 'suspended')"
                            groups="product_graph_base.group_pg_approver"/>
                    <button name="action_suspend" string="Suspend"
                            type="object" class="btn-warning"
                            invisible="state not in ('probationary', 'qualified')"
                            groups="product_graph_base.group_pg_approver"
                            context="{'default_qualification_comment': 'Suspended pending review'}"
                            confirm="Suspend this vendor? A reason will be logged."/>
                    <button name="action_disqualify" string="Disqualify"
                            type="object" class="btn-danger"
                            invisible="state == 'disqualified'"
                            groups="product_graph_base.group_pg_approver"
                            context="{'default_qualification_comment': 'Disqualified'}"
                            confirm="Disqualify this vendor? This is a terminal state."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="unqualified,probationary,qualified"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vendor_parts" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="vendor_part_count" widget="statinfo"
                                   string="Parts"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Disqualified"
                            bg_color="text-bg-danger"
                            invisible="state != 'disqualified'"/>
                    <widget name="web_ribbon" title="Suspended"
                            bg_color="text-bg-warning"
                            invisible="state != 'suspended'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Vendor name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="partner_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="is_approved" readonly="1"/>
                        </group>
                        <group>
                            <field name="qualified_on" readonly="1"/>
                            <field name="qualified_by_id" readonly="1"/>
                            <field name="qualification_expires_on"/>
                            <field name="responsible_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Approved Categories">
                        <field name="category_ids" nolabel="1" widget="many2many_tags"
                               options="{'no_create_edit': True}"/>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                        <page string="Approved Parts"
                              name="vendor_parts">
                            <field name="vendor_part_ids">
                                <list editable="bottom">
                                    <field name="item_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="vendor_part_number"/>
                                    <field name="rank"/>
                                    <field name="is_preferred" widget="boolean_toggle"/>
                                    <field name="moq"/>
                                    <field name="unit_price_hint"/>
                                    <field name="currency_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="lead_time_days"/>
                                </list>
                            </field>
                        </page>
                        <page string="Qualification Log"
                              name="qualification">
                            <field name="qualification_ids" readonly="1">
                                <list>
                                    <field name="decided_on"/>
                                    <field name="decided_by_id"/>
                                    <field name="decision" widget="badge"
                                           decoration-success="decision == 'qualified'"
                                           decoration-warning="decision == 'suspended'"
                                           decoration-danger="decision == 'disqualified'"/>
                                    <field name="valid_from" optional="hide"/>
                                    <field name="valid_until" optional="show"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pg_vendor" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">pg.vendor</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_pg_vendor_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>

</odoo>
