# ProductGraph MCP sidecar — environment configuration.
# Drop a copy of this as .env in the mcp/ directory or pass via docker --env-file.

# Odoo instance — the deployment the MCP server bridges to.
PRODUCTGRAPH_ODOO_URL=https://southbrook.example.com
PRODUCTGRAPH_DB=southbrook

# Personal API key for the operating user. Per Decision D6 this user
# must have at least group_pg_engineer for mutating tools to work.
# Generate in Odoo via My Profile > Account Security > New API Key.
PRODUCTGRAPH_ODOO_USER=mcp-bot@southbrook.example.com
PRODUCTGRAPH_API_KEY=changeme-from-odoo-personal-api-key

# Transport — stdio (Claude Desktop default) or sse (HTTP remote).
PRODUCTGRAPH_MCP_TRANSPORT=stdio

# SSE-only options.
PRODUCTGRAPH_MCP_HOST=0.0.0.0
PRODUCTGRAPH_MCP_PORT=9234

# Optional. Soft cap on read endpoints to protect Odoo from runaway agent loops.
PRODUCTGRAPH_DEFAULT_LIMIT=50
PRODUCTGRAPH_MAX_LIMIT=500

# Logging.
PRODUCTGRAPH_LOG_LEVEL=INFO
