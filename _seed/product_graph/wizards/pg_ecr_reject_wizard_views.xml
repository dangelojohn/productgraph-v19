<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_ecr_reject_wizard_form" model="ir.ui.view">
        <field name="name">pg.ecr.reject.wizard.form</field>
        <field name="model">pg.ecr.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Change Request">
                <sheet>
                    <group>
                        <field name="change_request_id" readonly="1"/>
                    </group>
                    <group string="Rejection Reason">
                        <field name="rejection_reason"
                               nolabel="1"
                               placeholder="Explain clearly why this ECR is being rejected…"
                               required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reject"
                            string="Confirm Rejection"
                            type="object"
                            class="btn btn-danger"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
