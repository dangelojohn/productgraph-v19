<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_audit_log_list" model="ir.ui.view">
        <field name="name">pg.audit.log.list</field>
        <field name="model">pg.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log" create="0" edit="0" delete="0">
                <field name="create_date" string="Date/Time"/>
                <field name="name"/>
                <field name="item_id"/>
                <field name="revision_id"/>
                <field name="action"/>
                <field name="from_state"/>
                <field name="to_state"/>
                <field name="user_id"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_pg_audit_log_form" model="ir.ui.view">
        <field name="name">pg.audit.log.form</field>
        <field name="model">pg.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log Entry" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="item_id"     readonly="1"/>
                            <field name="revision_id" readonly="1"/>
                            <field name="action"      readonly="1"/>
                            <field name="from_state"  readonly="1"/>
                            <field name="to_state"    readonly="1"/>
                        </group>
                        <group>
                            <field name="user_id"     readonly="1"/>
                            <field name="create_date" string="Date/Time" readonly="1"/>
                            <field name="triggered_by_model"  readonly="1"/>
                            <field name="triggered_by_res_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"   readonly="1" nolabel="1"/>
                    </group>
                    <group string="Payload" invisible="not payload">
                        <field name="payload" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pg_audit_log_search" model="ir.ui.view">
        <field name="name">pg.audit.log.search</field>
        <field name="model">pg.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="item_id"/>
                <field name="user_id"/>
                <field name="action"/>
                <filter string="Releases"      name="releases"    domain="[('action','=','release')]"/>
                <filter string="State Changes" name="state_chg"   domain="[('action','=','state_change')]"/>
                <filter string="ECR Events"    name="ecr"
                        domain="[('action','in',['ecr_approve','ecr_reject'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Action" name="group_action" context="{'group_by': 'action'}"/>
                    <filter string="Item"   name="group_item"   context="{'group_by': 'item_id'}"/>
                    <filter string="User"   name="group_user"   context="{'group_by': 'user_id'}"/>
                    <filter string="Date"   name="group_date"   context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pg_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">pg.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pg_audit_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No audit log entries yet.
            </p>
        </field>
    </record>

</odoo>
