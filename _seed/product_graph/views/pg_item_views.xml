<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         pg.item — Engineering Item FORM
         ============================================================ -->

    <record id="view_pg_item_form" model="ir.ui.view">
        <field name="name">pg.item.form</field>
        <field name="model">pg.item</field>
        <field name="arch" type="xml">
            <form string="Engineering Item">
                <header>
                    <button name="action_to_engineering"
                            string="Start Engineering"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'engineering'"/>
                    <button name="action_obsolete"
                            string="Obsolete"
                            type="object"
                            confirm="Are you sure you want to obsolete this item? This cannot be undone."
                            invisible="state != 'released'"
                            groups="product_graph.group_pg_release_manager"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,engineering,released,obsolete"/>
                </header>
                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_revisions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-code-fork"
                                invisible="revision_count == 0">
                            <field name="revision_count" widget="statinfo" string="Revisions"/>
                        </button>
                        <button name="action_view_boms"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list-alt"
                                invisible="bom_count == 0">
                            <field name="bom_count" widget="statinfo" string="BOMs"/>
                        </button>
                        <button name="action_view_mos"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-wrench"
                                invisible="mo_count == 0">
                            <field name="mo_count" widget="statinfo" string="MOs"/>
                        </button>
                        <button name="action_create_change_request"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exchange">
                            <field name="change_request_count" widget="statinfo" string="ECRs"/>
                        </button>
                        <button name="%(action_pg_asset)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-microchip"
                                invisible="asset_count == 0">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                    </div>

                    <!-- Image -->
                    <field name="image_1920" widget="image"
                           class="oe_avatar"
                           options="{'zoom': True, 'preview_image': 'image_128'}"/>

                    <div class="oe_title">
                        <label for="item_number"/>
                        <h1>
                            <field name="item_number" readonly="state != 'draft'"/>
                        </h1>
                        <label for="name"/>
                        <h2>
                            <field name="name"
                                   placeholder="Item name…"
                                   readonly="state == 'released'"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="item_type"
                                   readonly="state == 'released'"/>
                            <field name="category_id"
                                   readonly="state == 'released'"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <field name="current_revision_name" string="Current Rev"/>
                        </group>
                        <group string="Responsibility">
                            <field name="responsible_id"/>
                            <field name="reviewer_id"/>
                            <field name="released_date" readonly="1"/>
                            <field name="obsolete_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Revisions" name="revisions">
                            <field name="revision_ids" context="{'default_item_id': id}">
                                <list decoration-success="state == 'released'"
                                      decoration-warning="state == 'in_review' or state == 'approved'"
                                      decoration-muted="state == 'obsolete'">
                                    <field name="revision_code"/>
                                    <field name="display_name_full"/>
                                    <field name="state"/>
                                    <field name="bom_line_count" string="Components"/>
                                    <field name="approved_date"/>
                                    <field name="released_date"/>
                                </list>
                            </field>
                            <div class="o_field_widget mt-2">
                                <button name="action_create_revision"
                                        type="object"
                                        string="New Revision"
                                        class="btn btn-secondary"
                                        invisible="state not in ['engineering', 'released']"/>
                            </div>
                        </page>
                        <page string="Linked Product" name="product">
                            <group>
                                <field name="product_id" readonly="1"/>
                                <field name="product_template_id" readonly="1"/>
                            </group>
                        </page>
                        <page string="Manufacturing Notes" name="mfg_notes">
                            <field name="manufacturing_notes"/>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="internal_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================
         pg.item — LIST
         ============================================================ -->

    <record id="view_pg_item_list" model="ir.ui.view">
        <field name="name">pg.item.list</field>
        <field name="model">pg.item</field>
        <field name="arch" type="xml">
            <list string="Engineering Items"
                  decoration-success="state == 'released'"
                  decoration-warning="state == 'engineering'"
                  decoration-muted="state == 'obsolete'">
                <field name="item_number"/>
                <field name="name"/>
                <field name="item_type"/>
                <field name="category_id"/>
                <field name="current_revision_name" string="Rev"/>
                <field name="state"/>
                <field name="responsible_id"/>
                <field name="revision_count" string="Revs"/>
                <field name="bom_count" string="BOMs"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         pg.item — KANBAN
         ============================================================ -->

    <record id="view_pg_item_kanban" model="ir.ui.view">
        <field name="name">pg.item.kanban</field>
        <field name="model">pg.item</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column"
                    default_group_by="state"
                    group_create="false">
                <field name="state"/>
                <field name="item_number"/>
                <field name="name"/>
                <field name="item_type"/>
                <field name="responsible_id"/>
                <field name="current_revision_name"/>
                <field name="color"/>
                <field name="tag_ids"/>
                <field name="image_128"/>
                <progressbar field="state"
                             colors='{"released": "success", "obsolete": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image">
                            <img t-att-src="kanban_image('pg.item', 'image_128', record.id.raw_value)"
                                 alt="Item"/>
                        </div>
                        <div class="oe_kanban_global_click o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    [<field name="item_number"/>] <field name="name"/>
                                </strong>
                                <small class="o_kanban_record_subtitle text-muted">
                                    <field name="item_type"/>
                                    <t t-if="record.current_revision_name.value">
                                        · Rev <field name="current_revision_name"/>
                                    </t>
                                </small>
                            </div>
                        </div>
                        <div class="oe_kanban_bottom_left">
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </div>
                        <div class="oe_kanban_bottom_right">
                            <img t-att-src="kanban_image('res.users', 'image_128', record.responsible_id.raw_value)"
                                 class="oe_kanban_avatar o_image_24_cover"
                                 t-att-title="record.responsible_id.value"
                                 alt="Responsible"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================
         pg.item — SEARCH
         ============================================================ -->

    <record id="view_pg_item_search" model="ir.ui.view">
        <field name="name">pg.item.search</field>
        <field name="model">pg.item</field>
        <field name="arch" type="xml">
            <search string="Search Items">
                <field name="item_number" string="Item Number"/>
                <field name="name" string="Item Name"/>
                <field name="category_id"/>
                <field name="responsible_id"/>
                <field name="tag_ids"/>
                <!-- Filters -->
                <filter string="Draft"         name="draft"       domain="[('state','=','draft')]"/>
                <filter string="In Engineering" name="engineering" domain="[('state','=','engineering')]"/>
                <filter string="Released"      name="released"    domain="[('state','=','released')]"/>
                <filter string="Obsolete"      name="obsolete"    domain="[('state','=','obsolete')]"/>
                <separator/>
                <filter string="My Items"      name="my_items"    domain="[('responsible_id','=',uid)]"/>
                <filter string="Archived"      name="inactive"    domain="[('active','=',False)]"/>
                <!-- Group by -->
                <group expand="0" string="Group By">
                    <filter string="Status"     name="group_state"    context="{'group_by': 'state'}"/>
                    <filter string="Category"   name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Item Type"  name="group_type"     context="{'group_by': 'item_type'}"/>
                    <filter string="Responsible" name="group_resp"    context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         Actions
         ============================================================ -->

    <record id="action_pg_item" model="ir.actions.act_window">
        <field name="name">Engineering Items</field>
        <field name="res_model">pg.item</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_pg_item_search"/>
        <field name="context">{'search_default_released': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first engineering item
            </p>
            <p>
                Items are the core registry of everything your engineering team designs,
                from individual components to top-level assemblies.
            </p>
        </field>
    </record>

    <record id="action_pg_item_all" model="ir.actions.act_window">
        <field name="name">All Items</field>
        <field name="res_model">pg.item</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No items found.</p>
        </field>
    </record>

</odoo>
