<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_cr_form" model="ir.ui.view">
        <field name="name">pg.change.request.form</field>
        <field name="model">pg.change.request</field>
        <field name="arch" type="xml">
            <form string="Engineering Change Request">
                <header>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_start_impact_review"
                            string="Start Impact Review"
                            type="object"
                            invisible="state != 'submitted'"/>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'impact_review'"
                            groups="product_graph.group_pg_approver"/>
                    <button name="action_start_implementing"
                            string="Start Implementing"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_mark_implemented"
                            string="Mark Implemented"
                            type="object"
                            invisible="state != 'implementing'"/>
                    <button name="action_close"
                            string="Close"
                            type="object"
                            invisible="state not in ['implemented','rejected']"/>
                    <button name="action_reject"
                            string="Reject…"
                            type="object"
                            invisible="state in ['rejected','closed','implemented']"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ['submitted','impact_review']"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,impact_review,approved,implementing,implemented"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <label for="title"/>
                        <h2>
                            <field name="title"
                                   placeholder="Short description of the change…"
                                   readonly="state not in ['draft','submitted']"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="item_id"
                                   readonly="state not in ['draft','submitted']"/>
                            <field name="change_type"
                                   readonly="state not in ['draft','submitted']"/>
                            <field name="priority"  widget="priority"/>
                            <field name="target_date"/>
                        </group>
                        <group string="People">
                            <field name="requester_id" readonly="1"/>
                            <field name="reviewer_id"/>
                            <field name="approver_id"/>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="rejected_by_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Affected Revisions">
                        <field name="affected_revision_ids"
                               widget="many2many_tags"
                               domain="[('item_id','=',item_id)]"
                               nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Problem Statement" name="problem">
                            <field name="description" readonly="state not in ['draft','submitted']"/>
                        </page>
                        <page string="Proposed Solution" name="solution">
                            <field name="proposed_solution"/>
                        </page>
                        <page string="Impact Analysis" name="impact">
                            <field name="impact_analysis"/>
                        </page>
                        <page string="Implementation" name="impl">
                            <group>
                                <field name="new_revision_id" readonly="state not in ['approved','implementing']"/>
                                <field name="implemented_date" readonly="1"/>
                                <field name="closed_date" readonly="1"/>
                            </group>
                        </page>
                        <page string="Rejection" name="reject"
                              invisible="state not in ['rejected','closed']">
                            <group>
                                <field name="rejection_reason" readonly="1"/>
                                <field name="rejected_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pg_cr_list" model="ir.ui.view">
        <field name="name">pg.change.request.list</field>
        <field name="model">pg.change.request</field>
        <field name="arch" type="xml">
            <list string="Change Requests"
                  decoration-success="state == 'implemented'"
                  decoration-warning="state in ['submitted','impact_review','approved']"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="title"/>
                <field name="item_id"/>
                <field name="change_type"/>
                <field name="priority" widget="priority"/>
                <field name="state"/>
                <field name="requester_id"/>
                <field name="target_date"/>
                <field name="approved_date"/>
            </list>
        </field>
    </record>

    <record id="view_pg_cr_kanban" model="ir.ui.view">
        <field name="name">pg.change.request.kanban</field>
        <field name="model">pg.change.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <field name="name"/>
                <field name="title"/>
                <field name="priority"/>
                <field name="item_id"/>
                <field name="requester_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/> — <field name="title"/>
                                    </strong>
                                    <small class="text-muted">
                                        <field name="item_id"/>
                                    </small>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <img t-att-src="kanban_image('res.users','image_128',record.requester_id.raw_value)"
                                     class="oe_kanban_avatar o_image_24_cover"
                                     t-att-title="record.requester_id.value"
                                     alt="Requester"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pg_cr_search" model="ir.ui.view">
        <field name="name">pg.change.request.search</field>
        <field name="model">pg.change.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="item_id"/>
                <field name="requester_id"/>
                <filter string="Draft"         name="draft"        domain="[('state','=','draft')]"/>
                <filter string="Submitted"     name="submitted"    domain="[('state','=','submitted')]"/>
                <filter string="In Review"     name="review"       domain="[('state','=','impact_review')]"/>
                <filter string="Approved"      name="approved"     domain="[('state','=','approved')]"/>
                <filter string="Implementing"  name="implementing" domain="[('state','=','implementing')]"/>
                <filter string="Implemented"   name="implemented"  domain="[('state','=','implemented')]"/>
                <filter string="Rejected"      name="rejected"     domain="[('state','=','rejected')]"/>
                <separator/>
                <filter string="Open"          name="open"
                        domain="[('state','not in',['closed','rejected'])]"/>
                <filter string="My ECRs"       name="my_ecr"
                        domain="[('requester_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status"      name="group_state"  context="{'group_by': 'state'}"/>
                    <filter string="Item"        name="group_item"   context="{'group_by': 'item_id'}"/>
                    <filter string="Change Type" name="group_type"   context="{'group_by': 'change_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pg_change_request" model="ir.actions.act_window">
        <field name="name">Change Requests (ECR)</field>
        <field name="res_model">pg.change.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No change requests yet
            </p>
            <p>
                Engineering Change Requests (ECR) formalise proposals to modify
                released items. They drive the full impact-review and approval workflow.
            </p>
        </field>
    </record>

</odoo>
